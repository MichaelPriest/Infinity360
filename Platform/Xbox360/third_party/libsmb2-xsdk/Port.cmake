# Configure only on explicit user-selected experimental target.
function(infinity_prepare_smb2 source output mode)
  find_package(Python3 REQUIRED COMPONENTS Interpreter)
  set(port_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  set(args "")
  if(mode STREQUAL "xsdk")
    list(APPEND args --xsdk)
  endif()
  # Recreate only the generated subdirectory; do not mutate the source checkout.
  if(EXISTS "${output}")
    if(NOT EXISTS "${output}/.infinity-prepared")
      message(FATAL_ERROR "Refusing to remove unmarked SMB source directory: ${output}")
    endif()
    file(REMOVE_RECURSE "${output}")
  endif()
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${port_dir}/prepare.py"
    "${source}" "${output}" ${args} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Pinned SMB source preparation failed")
  endif()
endfunction()

function(infinity_smb2_options)
  foreach(option BUILD_SHARED_LIBS ENABLE_EXAMPLES ENABLE_UTILS ENABLE_LIBDCERPC
      ENABLE_LIBKRB5 ENABLE_GSSAPI ENABLE_LIBQUIC ENABLE_RDMA ENABLE_OPENSSL)
    set(${option} OFF CACHE BOOL "Infinity experimental SMB provider" FORCE)
  endforeach()
endfunction()

function(infinity_smb2_xsdk source)
  if(NOT XSDK OR NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "powerpc")
    message(FATAL_ERROR "SMB console port requires the XSDK PowerPC toolchain")
  endif()
  infinity_smb2_options()
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/infinity-libsmb2-xsdk-src")
  infinity_prepare_smb2("${source}" "${generated}" xsdk)
  include(CheckIncludeFile)
  check_include_file("sys/uio.h" INFINITY_SMB_HAS_IOVEC)
  add_subdirectory("${generated}" "${CMAKE_CURRENT_BINARY_DIR}/infinity-libsmb2-xsdk-build" EXCLUDE_FROM_ALL)
  if(NOT TARGET smb2)
    message(FATAL_ERROR "Expected upstream smb2 static target")
  endif()
  target_compile_options(smb2 PRIVATE -include "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/io_compat.h")
  if(INFINITY_SMB_HAS_IOVEC)
    target_compile_definitions(smb2 PRIVATE INFINITY_SMB_HAS_IOVEC=1)
  endif()
endfunction()
