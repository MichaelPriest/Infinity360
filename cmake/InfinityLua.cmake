option(INFINITY_ENABLE_LUA "Build bounded Lua scripting runtime" OFF)
function(infinity_enable_lua target)
  if(NOT INFINITY_ENABLE_LUA)
    return()
  endif()
  if(NOT TARGET infinity_lua)
    include(FetchContent)
    FetchContent_Declare(infinity_lua
      URL https://www.lua.org/ftp/lua-5.4.9.tar.gz
      URL_HASH SHA256=2335b6c582a52654f94612bf10d2f4672805d05329aa6568b1d8cd9e5c6fb8e6)
    FetchContent_GetProperties(infinity_lua)
    if(NOT infinity_lua_POPULATED)
      FetchContent_Populate(infinity_lua)
    endif()
    set(src "${infinity_lua_SOURCE_DIR}/src")
    set(files lapi lcode lctype ldebug ldo ldump lfunc lgc llex lmem lobject lopcodes lparser lstate lstring ltable ltm lundump lvm lzio lauxlib lbaselib ltablib lstrlib)
    set(sources "")
    foreach(file IN LISTS files)
      list(APPEND sources "${src}/${file}.c")
    endforeach()
    add_library(infinity_lua STATIC ${sources})
    target_include_directories(infinity_lua PUBLIC "${src}")
    # The XSDK libc limits header omits C99 long-long macros in C++.
    # Force the same compatibility header into Lua and all its consumers;
    # retain the default 64-bit Lua integer ABI (unsigned title IDs fit).
    if(CMAKE_CROSSCOMPILING AND CMAKE_C_COMPILER_ID STREQUAL "GNU")
      target_compile_options(infinity_lua PUBLIC -include "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/LuaLimitsCompat.h")
    endif()
    if(NOT WIN32)
      target_link_libraries(infinity_lua PUBLIC m)
    endif()
  endif()
  target_link_libraries(${target} PRIVATE infinity_lua)
  target_compile_definitions(${target} PRIVATE INFINITY_WITH_LUA=1)
endfunction()
